min_usage_version "6.12.0"
name "app"
bin "app"
flag "-h --help" help="Show context-sensitive help."
flag "--a <STRING>" help="A." {
    requires "--b" "--two"
}
flag "--b <STRING>" help="B." {
    requires "--a" "--two"
}
flag "--c <STRING>" help="C." required=#true {
    requires "--d" "--e" "--two"
}
flag "--d <STRING>" help="D." required=#true {
    requires "--c" "--e" "--two"
}
flag "--e <STRING>" help="E." required=#true {
    requires "--c" "--d" "--two"
}
flag "--f <STRING>" help="F." overrides="--g"
flag "--g <STRING>" help="G." overrides="--f"
flag "--two <STRING>" help="Two groups." required=#true {
    requires "--a" "--b" "--c" "--d" "--e"
}
