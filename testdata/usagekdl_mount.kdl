min_usage_version "6.12.0"
name "app"
bin "app"
disable_help_flag #true
disable_help_subcommand #true
flag "-h --help" help="Show context-sensitive help." action="help" global=#true
flag "--verbose" help="Be verbose." bool_value=#true global=#true
cmd "tool" help="Run the tool." display_order=0 subcommand_required=#true disable_help_flag=#true disable_help_subcommand=#true effect="write" surface="cli" {
    help_md "The **tool**."
    example "app tool --dry-run sub"
    flag "--dry-run" help="Do nothing." bool_value=#true global=#true {
        long_help "Does nothing at all."
    }
    cmd "sub" help="Sub." display_order=0 disable_help_flag=#true effect="read"
}
cmd "other" help="Run the tool without changes." display_order=1 subcommand_required=#true disable_help_flag=#true disable_help_subcommand=#true surface="cli" {
    help_md "The **tool**."
    example "tool --dry-run sub" header="Dry run"
    flag "--dry-run" help="Do nothing." bool_value=#true global=#true {
        long_help "Does nothing at all."
    }
    cmd "sub" help="Sub." display_order=0 disable_help_flag=#true effect="read"
}
