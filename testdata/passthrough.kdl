min_usage_version "6.12.0"
name "app"
bin "app"
disable_help_flag #true
disable_help_subcommand #true
flag "-h --help" help="Show context-sensitive help." action="help" global=#true
cmd "exec" help="Passthrough command." display_order=0 disable_help_flag=#true {
    arg "[args]..." help="Arguments." double_dash="automatic"
}
cmd "all" help="Passthrough positional." display_order=1 disable_help_flag=#true {
    flag "--flag" help="Flag." bool_value=#true
    arg "[args]..." help="Arguments." double_dash="automatic"
}
cmd "partial" help="Partial passthrough positional." display_order=2 disable_help_flag=#true {
    flag "--flag" help="Flag." bool_value=#true
    arg "[args]..." help="Arguments." double_dash="automatic"
}
