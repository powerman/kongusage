min_usage_version "6.12.0"
name "app"
bin "app"
about "App."
disable_help_flag #true
disable_help_subcommand #true
license "MIT"
exit_code 3 "Root."
flag "-h --help" help="Show context-sensitive help." action="help" global=#true
cmd "deploy" help="UsageKDL of the type." display_order=0 disable_help_flag=#true effect="destructive" {
    example "app show"
    exit_code 5 "Patched."
}
cmd "show" help="No usage features." display_order=1 disable_help_flag=#true effect="read" {
    example "app show"
}
cmd "pin" help="The tag replaces." display_order=2 disable_help_flag=#true effect="destructive" {
    example "app show"
    exit_code 7 "Tag."
}
cmd "rm" help="The tag removes." display_order=3 disable_help_flag=#true effect="destructive" {
    example "app show"
}
cmd "ls" help="Described by the root." display_order=4 disable_help_flag=#true
cmd "grp" help="Has a subcommand." display_order=5 subcommand_required=#true disable_help_flag=#true disable_help_subcommand=#true {
    exit_code 3 "Root."
    exit_code 4 "Cmd."
    cmd "leaf" help="Leaf." display_order=0 disable_help_flag=#true effect="write" {
        exit_code 3 "Root."
        exit_code 4 "Cmd."
    }
}
