min_usage_version "6.12.0"
name "app"
bin "app"
flag "-h --help" help="Show context-sensitive help."
flag "--neg" help="Negatable." negate="--no-neg"
flag "--neg-x" help="Negatable custom." negate="--without-x"
flag "-v --verbose" help="Counter." count=#true
flag "--slice <SLICE>" help="Slice." var=#true
flag "--named <TEST-NAMED-SLICE>" help="Named slice." var=#true
flag "--map <KEY=VALUE>" help="Map." var=#true
flag "--mapped <STRING>" help="Custom mapper."
flag "--mapper-val <TEST-MAPPER-VALUE>" help="MapperValue."
flag "--bool-val" help="MapperValue with IsBool."
