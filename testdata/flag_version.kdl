min_usage_version "6.12.0"
name "app"
bin "app"
version "1.2.3"
disable_help_flag #true
disable_help_subcommand #true
disable_version_flag #true
flag "-h --help" help="Show context-sensitive help." action="help" global=#true
flag "-V --version" help="Show version." action="version" global=#true
cmd "sub" help="Sub." display_order=0 disable_help_flag=#true
