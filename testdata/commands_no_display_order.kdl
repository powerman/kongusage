min_usage_version "6.12.0"
name "app"
bin "app"
disable_help_flag #true
disable_help_subcommand #true
flag "-h --help" help="Show context-sensitive help." action="help" global=#true
cmd "serve" help="Start a server." long_help="Serves files\nover HTTP." disable_help_flag=#true {
    alias "s" "srv"
}
cmd "remote" help="Manage remotes." subcommand_required=#true disable_help_flag=#true disable_help_subcommand=#true {
    cmd "add" help="Add a remote." disable_help_flag=#true
    cmd "rm" help="Remove a remote." disable_help_flag=#true
}
cmd "debug" help="Debug." hide=#true disable_help_flag=#true
cmd "tool" help="Tool." disable_help_flag=#true disable_help_subcommand=#true {
    cmd "secret" help="Secret." hide=#true disable_help_flag=#true
}
cmd "val-run" help="Run on a value receiver." disable_help_flag=#true disable_help_subcommand=#true {
    cmd "sub" help="Sub." disable_help_flag=#true
}
cmd "opt" help="Run or choose a subcommand." disable_help_flag=#true disable_help_subcommand=#true {
    cmd "sub" help="Sub." disable_help_flag=#true
}
cmd "def" help="With a default subcommand." disable_help_flag=#true disable_help_subcommand=#true {
    cmd "a" help="A." disable_help_flag=#true
    cmd "b" help="B." disable_help_flag=#true
}
