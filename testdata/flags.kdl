min_usage_version "6.12.0"
name "app"
bin "app"
flag "-h --help" help="Show context-sensitive help."
flag "-s --short <STRING>" help="Short and long."
flag "--required <STRING>" help="Required." required=#true
flag "--hidden" help="Hidden." hide=#true
flag "--place <FILE>" help="Placeholder."
flag "--help-2 <STRING>" help="Multi-line\nhelp."
flag "--no-help <STRING>"
