min_usage_version "6.12.0"
name "app"
bin "app"
flag "-h --help" help="Show context-sensitive help."
flag "--color <STRING>" help="Enum." default="auto" {
    choices "auto" "always" "never"
}
flag "--vars <STRING>" help="Default a, one of a,b, from APP_H." hide_default_value=#true hide_possible_values=#true hide_env=#true default="a" env="APP_H" {
    choices "a" "b"
}
