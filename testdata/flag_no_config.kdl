min_usage_version "6.12.0"
name "test"
bin "test"
flag "-h --help" help="Show context-sensitive help."
flag "--name <STRING>" help="Name." env="TEST_NAME"
flag "--usage-spec" help="Print usage spec (KDL) and exit."
cmd "sub" help="Subcommand." display_order=0
cmd "other" help="Other subcommand." display_order=1
