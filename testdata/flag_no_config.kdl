min_usage_version "6.12.0"
name "test"
bin "test"
disable_help_flag #true
disable_help_subcommand #true
flag "-h --help" help="Show context-sensitive help." action="help" global=#true
flag "--name <STRING>" help="Name." global=#true env="TEST_NAME"
flag "--usage-spec" help="Print usage spec (KDL) and exit." bool_value=#true global=#true
cmd "sub" help="Subcommand." display_order=0 disable_help_flag=#true
cmd "other" help="Other subcommand." display_order=1 disable_help_flag=#true
