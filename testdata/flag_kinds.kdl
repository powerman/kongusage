min_usage_version "6.12.0"
name "app"
bin "app"
disable_help_flag #true
flag "-h --help" help="Show context-sensitive help." action="help" global=#true
flag "--neg" help="Negatable." negate="--no-neg" bool_value=#true
flag "--neg-x" help="Negatable custom." negate="--without-x" bool_value=#true
flag "-v --verbose" help="Counter." count=#true
flag "--slice <SLICE>" help="Slice." var=#true delimiter=","
flag "--named <TEST-NAMED-SLICE>" help="Named slice." var=#true delimiter=","
flag "--map <KEY=VALUE>" help="Map." var=#true delimiter=";"
flag "--mapped <STRING>" help="Custom mapper."
flag "--mapper-val <TEST-MAPPER-VALUE>" help="MapperValue."
flag "--bool-val" help="MapperValue with IsBool." bool_value=#true
