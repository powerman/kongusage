min_usage_version "6.12.0"
name "app"
bin "app"
disable_help_flag #true
disable_help_subcommand #true
flag "-h --help" help="Show context-sensitive help." action="help" global=#true
cmd "serve" help="Start a server." long_help="Serves files\nover HTTP." display_order=0 disable_help_flag=#true {
    alias "s" "srv"
}
cmd "remote" help="Manage remotes." display_order=1 subcommand_required=#true disable_help_flag=#true disable_help_subcommand=#true {
    cmd "add" help="Add a remote." display_order=0 disable_help_flag=#true
    cmd "rm" help="Remove a remote." display_order=1 disable_help_flag=#true
}
cmd "debug" help="Debug." hide=#true display_order=2 disable_help_flag=#true
cmd "tool" help="Tool." display_order=3 disable_help_flag=#true disable_help_subcommand=#true {
    cmd "secret" help="Secret." hide=#true display_order=0 disable_help_flag=#true
}
cmd "val-run" help="Run on a value receiver." display_order=4 disable_help_flag=#true disable_help_subcommand=#true {
    cmd "sub" help="Sub." display_order=0 disable_help_flag=#true
}
cmd "opt" help="Run or choose a subcommand." display_order=5 disable_help_flag=#true disable_help_subcommand=#true {
    cmd "sub" help="Sub." display_order=0 disable_help_flag=#true
}
cmd "def" help="With a default subcommand." display_order=6 disable_help_flag=#true disable_help_subcommand=#true {
    cmd "a" help="A." display_order=0 disable_help_flag=#true
    cmd "b" help="B." display_order=1 disable_help_flag=#true
}
