min_usage_version "6.12.0"
name "app"
bin "app"
disable_help_flag #true
disable_help_subcommand #true
flag "-h --help" help="Show context-sensitive help." action="help" global=#true
cmd "deploy" help="Deploy." display_order=0 disable_help_flag=#true effect="destructive" {
    example "app deploy --env=dev"
    flag "--env <ENV>" help="Env." required=#true {
        choices {
            choice "prod" help="Prod."
            choice "dev" hide=#true
        }
        long_help "Tag."
    }
    flag "--force" help="Force." bool_value=#true hide_short_help=#true {
        long_help "Overwrites."
    }
    flag "--region <STRING>" help="Region." {
        note "Tag."
    }
    flag "--size <TEST-SIZE-ID>" help="Size." {
        choices strict=#false {
            choice "l"
            choice "xl" help="Extra large."
            choice "s" help="Small." hide=#true
        }
    }
    flag "--level <TEST-LEVEL-ID>" help="Level." default="a" {
        choices "a" "b"
    }
}
cmd "build" help="Build." display_order=1 disable_help_flag=#true effect="write"
cmd "rm" help="Remove." display_order=2 disable_help_flag=#true {
    arg "<id>" help="ID." {
        note "Root."
        warning "Tag."
    }
}
