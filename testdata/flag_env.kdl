min_usage_version "6.12.0"
name "app"
bin "app"
disable_help_flag #true
flag "-h --help" help="Show context-sensitive help." action="help" global=#true
flag "--env <STRING>" help="Env." env="APP_A" {
    env_fallback "APP_B" "APP_C"
}
flag "--no-env <STRING>" help="No env."
flag "--version" help="Show version." action="version" global=#true
