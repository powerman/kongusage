min_usage_version "6.12.0"
name "app"
bin "app"
disable_help_flag #true
flag "-h --help" help="Show context-sensitive help." action="help" global=#true
flag "--props <STRING>" help="Properties." effect="read" surface="cli" available_if="linux" hide_short_help=#true hide_long_help=#false {
    help_md "**Props**."
    long_help "Long."
}
flag "--children <STRING>" help="Child nodes." effect="write" hide_short_help=#true {
    help_md "**Children**."
    long_help "Long."
    note "N1."
    note "N2."
    warning "W."
    available_if "a" "b"
}
flag "--run <STRING>" help="Run." {
    complete run="app hosts" descriptions=#true
}
flag "--delegate <STRING>" help="Delegate." {
    complete delegate="app complete"
}
flag "--type <INT>" help="Type." {
    complete type="hostname"
}
flag "--num <INT>" help="Suggested." {
    choices "1" "2" strict=#false
}
flag "--size <STRING>" help="Details." {
    choices strict=#false {
        choice "s" help="Small." hide=#true
        choice "m"
        choice "l" help="Large."
    }
}
flag "--env <STRING>" help="Enum." default="dev" {
    choices {
        choice "prod" help="Production."
        choice "dev"
    }
    note "Note."
}
arg "<file>" help="File." {
    complete type="file"
    note "Arg note."
}
